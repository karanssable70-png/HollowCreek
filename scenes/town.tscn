npc_id = "isolde"
npc_name = "Lady Isolde Ravenshade"
npc_role = "Noblewoman"
character_scene = ExtResource("char_isolde")
greeting = "A stranger walks our streets while blood still stains the storehouse timbers. Speak, but choose your words with care."
